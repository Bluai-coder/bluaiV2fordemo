{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
, "app/(careers)/layout.jsx", "app/products/(VitalsChair)/layout.jsx", "app/products/(BluAccess)/layout.jsx", "app/products/(BluHealth)/layout.jsx", "app/products/(BluID)/layout.jsx", "app/products/(BluNotes)/layout.jsx", "app/products/(BluMail)/layout.jsx", "app/products/(BluDMS)/layout.jsx", "app/products/(BluASHA)/layout.jsx"  ],
  "exclude": ["node_modules"]
}
